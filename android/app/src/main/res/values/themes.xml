<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.UrjaDashboard" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/urja_bg</item>
        <item name="android:statusBarColor">@color/urja_bg</item>
        <item name="android:navigationBarColor">@color/urja_bg</item>
    </style>

    <!-- Black, barless window for the launch clip, so there is no light flash
         between the launcher icon and the first video frame. -->
    <style name="Theme.UrjaSplash" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
