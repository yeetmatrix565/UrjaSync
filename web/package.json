{
  "name": "urja-sync-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepreview": "node scripts/ensure-export.mjs",
    "preview": "serve out -l 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
